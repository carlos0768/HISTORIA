# ---- DB ----
# 本番は Supabase の Supavisor（transaction モード）の URL を入れる（docs/12 §4）
DATABASE_URL=postgres://postgres@127.0.0.1:5433/historia
# テスト用。管理用DBを指す。テストはここに使い捨てDBを作って落とす
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres
# ローカルで PostgreSQL を建てる場合、データディレクトリは postgres が
# 所有できる場所に置くこと（/tmp 配下は権限が戻されてサーバーが落ちる）
#   PGDATA=/var/lib/postgresql/historia
# pgvector が入っていないローカルでは off。Supabase では設定しない
PGVECTOR=off

# ---- 認証（docs/03 §7 / docs/10 §3.2）----
# この2つが揃うと認証が有効になり、未認証は全経路 404 になる（G2）。
# 空のままだと proxy.ts の関門を素通りするので、DB も鍵も無いプレビューでも画面が描ける。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 認証が無効なとき（上が空のとき）だけ効く開発用の逃げ道。
# 上を設定した瞬間に無視される。本番では設定しない
DEMO_USER_ID=

# ---- AI（docs/08 §6）----
# 生成と検証は必ず別プロバイダにする。同じ値なら起動時に落とす。
# プロバイダとモデル id の食い違い（gemini に claude-* 等）も起動時に落とす。
# モデル id はそのままリクエストに乗るので、食い違うと 404 になるため
GEN_PROVIDER=anthropic
GEN_MODEL=claude-opus-5
VERIFY_PROVIDER=gemini
# ★ Gemini 3 Pro の id は未確認（docs/14 M35）。AI Studio で確かめてから入れる。
#   推測を書くと /models/<id>:generateContent が 404 になる
VERIFY_MODEL=gemini-3.6-flash
EMBED_MODEL=gemini-embedding-001

# 鍵が無い間は fake プロバイダで閉ループが最後まで通る
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
